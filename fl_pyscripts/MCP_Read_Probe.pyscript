# Script.Name = "MCP Read Probe"
# Script.Author = "rosasynthesiz"
# Script.Category = "MCP"
#
# E-0 spike v2 -- file I/O verdict for the piano-roll pyscript sandbox on FL 26.
#
# File I/O in this sandbox is expected to be blocked, and `print()` output is not
# visible in View > Script output, so the verdict is ALSO encoded as piano-roll
# notes (one note per check) -- readable from a screenshot, clearable by undo.
#
#   notes at bar 0 (length 0.1 bar, vel 0.9):
#     C6 (84) = script reached the end at all
#     C#6(85) = read  ~/.flstudio-mcp/probe.json   OK
#     D6 (86) = at least one write path succeeded
#     D#6(87) = ui module importable          (status bar possible)
#     E6 (88) = flpianoroll importable        (notes possible)
#     F6 (89) = channels importable
#     F#6(90) = general importable            (undo possible)
#     G6 (91) = crash in _run()               (instead of C6)
#
# Run from Piano roll > Tools > Scripts > MCP Read Probe (Cmd+Opt+Y re-runs last).

import json
import os

READ_PATH = os.path.expanduser("~/.flstudio-mcp/probe.json")
TARGETS = [
    os.path.expanduser("~/.flstudio-mcp/apply_receipt.json"),
    "/tmp/flmcp_apply_receipt.json",
    os.path.expanduser("~/Desktop/e0_apply_receipt.json"),
]


def _try_write(path, obj):
    try:
        with open(path, "w") as f:
            json.dump(obj, f, indent=1, sort_keys=True)
        return "ok"
    except Exception as e:
        return "%s: %s" % (type(e).__name__, e)


def _try_read(path):
    try:
        with open(path, "r") as f:
            return True, json.load(f), None
    except Exception as e:
        return False, None, "%s: %s" % (type(e).__name__, e)


def _imports():
    out = {}
    for name in ("flpianoroll", "ui", "channels", "mixer", "plugins", "transport",
                 "general", "patterns", "midi", "arrangement", "utils", "sys", "time"):
        try:
            __import__(name)
            out[name] = "ok"
        except Exception as e:
            out[name] = "%s: %s" % (type(e).__name__, e)
    return out


def _marker_notes(pitches):
    """Write one short note per pitch at bar 0. Replaces whatever is there."""
    import flpianoroll as flp
    score = flp.score
    try:
        score.clearNotes(True)     # FL 25.2.5: positional, no keyword
    except TypeError:
        score.clearNotes()
    step = score.PPQ // 4          # 1/16 note
    for i, pitch in enumerate(pitches):
        n = flp.Note()
        n.number = int(pitch)
        n.time = int(i * step * 2)
        n.length = max(1, step)
        n.velocity = 0.9
        score.addNote(n)


def _run():
    receipt = {"probe": "MCP_Read_Probe v2 (E-0)", "stage": "start"}
    receipt["first_write"] = {p: _try_write(p, receipt) for p in TARGETS}

    read_ok, data, read_err = _try_read(READ_PATH)
    receipt.update({"read_ok": read_ok, "read_data": data, "read_error": read_err})

    receipt["imports"] = imports = _imports()
    if imports.get("sys") == "ok":
        import sys
        receipt["python"] = sys.version

    receipt["stage"] = "done"
    receipt["write"] = {p: _try_write(p, receipt) for p in TARGETS}
    ok_paths = [p for p, r in receipt["write"].items() if r == "ok"]
    receipt["write_ok_paths"] = ok_paths

    bits = [84]                                    # reached end
    if read_ok:
        bits.append(85)
    if ok_paths:
        bits.append(86)
    for pitch, mod in ((87, "ui"), (88, "flpianoroll"),
                       (89, "channels"), (90, "general")):
        if imports.get(mod) == "ok":
            bits.append(pitch)
    _marker_notes(bits)                            # visible evidence

    verdict = "E-0 probe v2: read=%s writes=%d/%d bits=%s" % (
        "OK" if read_ok else ("FAIL %s" % read_err),
        len(ok_paths), len(TARGETS),
        ",".join(str(p) for p in bits),
    )
    print(verdict)
    try:
        ui = __import__("ui")
        ui.setHintMsg(verdict[:120])
        if hasattr(ui, "showNotification"):
            ui.showNotification(verdict[:120])
    except Exception as e:
        print("status-bar unavailable: %s: %s" % (type(e).__name__, e))
    return receipt


try:
    _run()
except Exception as e:
    msg = "E-0 probe v2 CRASH: %s: %s" % (type(e).__name__, e)
    for p in TARGETS:
        _try_write(p, {"probe": "MCP_Read_Probe v2 (E-0)", "stage": "CRASH",
                       "error": msg})
    try:
        _marker_notes([91])
    except Exception:
        pass
    print(msg)
